# Paths are expanded by sharun after the AppImage is mounted. Keep the
# Android ABI adapters separate from the host-ABI toolkit libraries.
USE_HOST_XDG_CACHE_HOME=1
GSETTINGS_BACKEND=keyfile
SHARUN_ALLOW_SYS_VKICD=1
SIGHTER_PORTABLE_MODE=standalone
SIGHTER_RUNTIME_LIBRARY_DIR=${SHARUN_DIR}/lib/sighter
SIGHTER_BIN=${SHARUN_DIR}/bin/sighter
SIGHTER_UPDATE_CANARY_BIN=${SHARUN_DIR}/bin/sighter
SIGHTER_UPDATE_HELPER=${SHARUN_DIR}/bin/sighter_updater
SIGHTER_WEBVIEW_HELPER=${SHARUN_DIR}/bin/sighter_webview_helper
SIGHTER_FAILURE_DIALOG_HELPER=${SHARUN_DIR}/bin/sighter_failure_dialog
SIGHTER_UPDATE_PROGRESS_HELPER=${SHARUN_DIR}/bin/sighter_failure_dialog
SIGHTER_FREEBSD_SOCKET_HELPER=${SHARUN_DIR}/share/sighter/helpers/sighter_freebsd_socket_helper
# sharun reloads .env for every child. Publish a default separately so it
# cannot overwrite a candidate-specific manifest supplied by the updater.
SIGHTER_PACKAGED_COMPATIBILITY_MANIFEST=${SHARUN_DIR}/share/sighter/metadata/roblox_compatibility.json
SIGHTER_UPDATE_COMPATIBILITY_PATH=${SHARUN_DIR}/share/sighter/metadata/roblox_compatibility.json
SIGHTER_UPDATE_SIGNING_TRUST_PATH=${SHARUN_DIR}/share/sighter/metadata/roblox_signing_certificates.json
SIGHTER_UPDATE_HOST_ABI_REFERENCE=${SHARUN_DIR}/share/sighter/metadata/roblox_host_abi_reference.json
SIGHTER_BOOTSTRAP_SOURCES_PATH=${SHARUN_DIR}/share/sighter/metadata/roblox_bootstrap_sources.json
