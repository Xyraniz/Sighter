# Maintainer: Xyraniz <109302452+Xyraniz@users.noreply.github.com>

pkgname=sighter
pkgver=1.0.4
pkgrel=1
pkgdesc='Android x86-64 Roblox compatibility runtime for Linux'
arch=('x86_64')
url='https://github.com/Xyraniz/Sighter'
license=('Apache-2.0')
depends=(
  'capstone'
  'curl'
  'fontconfig'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libelf'
  'libglvnd'
  'libplacebo'
  'libpng'
  'libsoup3'
  'libutf8proc'
  'libyaml'
  'minizip'
  'openssl'
  'sdl3>=3.4'
  'sdl3_ttf'
  'vulkan-icd-loader'
  'webkitgtk-6.0'
  'zlib'
)
makedepends=(
  'cmake>=3.20'
  'git'
  'lld'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'vulkan-headers'
)
optdepends=('gamemode: Feral GameMode integration')
conflicts=('sighter-bin' 'sighter-git')
options=('!debug' '!lto')
source=(
  "sighter::git+https://github.com/Xyraniz/Sighter.git#tag=${pkgver}"
)
sha256sums=(
  'SKIP'
)

prepare() {
  cd sighter

  sed -i \
    's|add_subdirectory(third_party/Vulkan-Headers EXCLUDE_FROM_ALL)|find_package(VulkanHeaders CONFIG REQUIRED)|' \
    CMakeLists.txt
}

build() {
  cmake -S sighter -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DSIGHTER_DEFAULT_COMPATIBILITY_MANIFEST=/usr/share/sighter/metadata/roblox_compatibility.json \
    -DSIGHTER_DEFAULT_SIGNING_TRUST_MANIFEST=/usr/share/sighter/metadata/roblox_signing_certificates.json \
    -DSIGHTER_ENABLE_UPSTREAM_JNIVM=OFF \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 sighter/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
